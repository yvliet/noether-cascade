{
  "name": "flint-cascade",
  "version": "1.0.1",
  "description": "Organize notes into sequential cascades (books) with status-bar linking, graph backlinks, and custom sidebar folders.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "flint-extension",
    "cascade",
    "book",
    "pages",
    "navigation",
    "graph",
    "backlinks"
  ],
  "author": "Yuliet Li <recrified@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yvliet/flint-cascade.git"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "flint": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  }
}
